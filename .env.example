# Copy to .env and adjust. Never commit .env.

# --- Postgres (docker-compose) ---
POSTGRES_USER=supportgraph
POSTGRES_PASSWORD=supportgraph
POSTGRES_DB=supportgraph
POSTGRES_PORT=5432

# --- Model gateway ---
# provider: ollama | openai_compat | fake
#   fake          -> scripted model, no network; used by tests and for a no-LLM demo
#   ollama        -> local model (install Ollama, then: ollama pull qwen2.5:7b)
#   openai_compat -> any OpenAI-compatible endpoint (free tiers like Groq/OpenRouter, or paid)
SG_LLM_PROVIDER=fake
SG_LLM_MODEL=qwen2.5:7b
SG_LLM_BASE_URL=http://localhost:11434
SG_LLM_API_KEY=

# --- Embeddings + RAG FAQ bot (build step 2) ---
# fake -> deterministic offline keyword-style embedder: for tests and the no-LLM demo, NOT for judging quality.
# Vectors must be 768-wide (the database column). nomic-embed-text is 768-wide:
#   ollama pull nomic-embed-text   and   SG_EMBEDDING_PROVIDER=ollama
# After changing the embedding model, run `make ingest` again (vectors from different models are never compared).
SG_EMBEDDING_PROVIDER=fake
SG_EMBEDDING_MODEL=nomic-embed-text
SG_EMBEDDING_BASE_URL=http://localhost:11434
SG_EMBEDDING_API_KEY=
# nomic-embed-text wants task prefixes; leave empty for other models.
SG_EMBEDDING_QUERY_PREFIX=
SG_EMBEDDING_DOCUMENT_PREFIX=
# Passages shown to the model per question, and the minimum cosine similarity for a passage to count as relevant.
# Below the minimum the bot abstains. Similarity scales differ by model: calibrate with `make eval-rag`.
SG_RAG_TOP_K=4
SG_RAG_MIN_SCORE=0.2
# Step 3: below this triage confidence the bot asks a clarifying question instead of guessing (0..1).
SG_TRIAGE_MIN_CONFIDENCE=0.6
# Step 3: how many searches the corrective knowledge agent may try per question (1..3; 1 = no retry).
SG_KNOWLEDGE_MAX_ATTEMPTS=2

# --- Step 4: approvals, checkpointing, QA ---
# Where runs paused for an approval are stored. `postgres` survives restarts and lets a staff console in another process resume
# them (run `make db-migrate` to create the tables). `memory` is lost when the process ends: only for quick demos.
SG_CHECKPOINTER=postgres
# How many times a reply that fails the QA checks may be revised before it is replaced by a safe fallback.
SG_QA_MAX_REVISIONS=1

# --- App ---
SG_DEFAULT_TENANT=qspiders_sample

# --- Tracing (self-hosted Langfuse; see README "Tracing with Langfuse") ---
# `make langfuse-init` generates the keys and writes them into your real .env for you.
# Tracing is OFF unless SG_TRACING_ENABLED=true AND both keys are set.
SG_TRACING_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://localhost:3100

# --- Step 5: web API + frontend ---
# Required by the API. Generate with `make auth-init` (writes SG_AUTH_SECRET into .env only if it is not set yet).
SG_AUTH_SECRET=
SG_TOKEN_TTL_MINUTES=480
SG_LOGIN_MAX_FAILURES=5
SG_LOGIN_LOCKOUT_SECONDS=300
SG_CHAT_MAX_MESSAGES_PER_MINUTE=20
# Comma-separated browser origins allowed to call the API directly. Leave empty when the frontend proxies /api (the default).
SG_CORS_ORIGINS=
