# Copy to .env and adjust. Never commit .env.

# --- Postgres (docker-compose) ---
POSTGRES_USER=supportgraph
POSTGRES_PASSWORD=supportgraph
POSTGRES_DB=supportgraph
POSTGRES_PORT=5432

# --- Model gateway ---
# provider: ollama | openai_compat | fake
#   fake          -> scripted model, no network; used by tests and for a no-LLM demo
#   ollama        -> local model (install Ollama, then: ollama pull qwen3:1.7b). Candidates are benchmarked on your machine: make bench-llm
#   openai_compat -> any OpenAI-compatible endpoint (free tiers like Groq/OpenRouter, or paid)
SG_LLM_PROVIDER=fake
SG_LLM_MODEL=qwen3:1.7b
# Opt-in candidate (better FAQ answers, ~1.5-2x slower, answered 1 of 7 held-out unanswerable questions): SG_LLM_MODEL=qwen3:4b-instruct-2507-q4_K_M with SG_LLM_MODEL_TRIAGE=qwen3:1.7b
# Sampling (defaults: temperature 0, provider defaults for the rest). Leave unset unless an experiment says otherwise (docs/MODEL_SELECTION.md):
# SG_LLM_TEMPERATURE=0.0
# SG_LLM_TOP_P=
# SG_LLM_TOP_K=
# SG_LLM_REPEAT_PENALTY=
# SG_LLM_SEED=
SG_LLM_BASE_URL=http://localhost:11434
SG_LLM_API_KEY=
# Optional per-role model, e.g. a smaller/faster model for triage. Empty = SG_LLM_MODEL.
# Roles: ACTION FAQ TRIAGE REWRITE PROPOSER CRITIC REVISER JUDGE
# SG_LLM_MODEL_TRIAGE=qwen3:1.7b
# Limits (milestone 0). One call must finish inside the timeout or the bot answers with a fixed "model unavailable" reply.
SG_LLM_TIMEOUT_SECONDS=60
SG_LLM_MAX_RETRIES=1
SG_LLM_MAX_OUTPUT_TOKENS=400
SG_LLM_NUM_CTX=4096
SG_LLM_KEEP_ALIVE=30m
SG_LLM_THINKING=false
# --- Real local AI (milestone 1b). To turn it on, edit YOUR .env (this file is only a template):
#   SG_LLM_PROVIDER=ollama   SG_EMBEDDING_PROVIDER=ollama   then: make ingest   make llm-smoke   make e2e-local
# Startup check of the Ollama server and the pulled models: off | warn (log, default) | strict (refuse to start).
# SG_LLM_PREFLIGHT=warn
# Load the models into memory in the background when the API starts, so the first student does not wait for a cold load.
# SG_LLM_WARMUP=true
# Optional extra model calls, OFF until measured on your machine (each adds seconds on CPU):
# SG_FAQ_CITATION_RETRIES=1   # an UNCITED answer is regenerated once with a reminder to cite (0 = never); same validation, abstains if it fails again
# SG_TRIAGE_OTHER_FLOOR=0.4   # category `other` at this confidence up to SG_TRIAGE_MIN_CONFIDENCE goes to the grounded FAQ instead of a clarifying question
# SG_QA_LLM_CRITIC=false      # LLM groundedness critic after the deterministic QA checks
# SG_REWRITER_MODE=glossary   # glossary (no model call) | llm (model rewrites the search query)
# Daily token cap for guarded calls; 0 = unlimited (right for local models). Only matters if you ever use a metered endpoint.
SG_LLM_DAILY_TOKEN_BUDGET=0
# Safety gate: any chat/embedding endpoint that is not on this machine or a private network is REFUSED unless this is true.
# Only turn it on deliberately, with synthetic data, after reading docs/decisions/0005-local-first-models.md.
SG_ALLOW_EXTERNAL_LLM=false

# --- Embeddings + RAG FAQ bot (build step 2) ---
# fake -> deterministic offline keyword-style embedder: for tests and the no-LLM demo, NOT for judging quality.
# Vectors must be 768-wide (the database column). nomic-embed-text is 768-wide:
#   ollama pull nomic-embed-text   and   SG_EMBEDDING_PROVIDER=ollama
# After changing the embedding model, run `make ingest` again (vectors from different models are never compared).
SG_EMBEDDING_PROVIDER=fake
SG_EMBEDDING_MODEL=nomic-embed-text
SG_EMBEDDING_BASE_URL=http://localhost:11434
SG_EMBEDDING_API_KEY=
# nomic-embed-text wants task prefixes. auto = the right ones for nomic-embed-text on a real provider (no-op for the fake embedder and for
# other models); none = never add them. Explicit QUERY/DOCUMENT prefixes below win. The prefix setting is part of the stored vector name, so
# changing it makes old vectors invisible (run `make ingest` again; nothing is deleted).
# SG_EMBEDDING_PREFIX_MODE=auto
SG_EMBEDDING_QUERY_PREFIX=
SG_EMBEDDING_DOCUMENT_PREFIX=
# Passages shown to the model per question, and the minimum cosine similarity for a passage to count as relevant.
# Below the minimum the bot abstains. Similarity scales differ by model: calibrate with `make eval-rag`.
SG_RAG_TOP_K=4
SG_RAG_MIN_SCORE=0.2
# Step 3: below this triage confidence the bot asks a clarifying question instead of guessing (0..1).
SG_TRIAGE_MIN_CONFIDENCE=0.6
# Step 3: how many searches the corrective knowledge agent may try per question (1..3; 1 = no retry).
SG_KNOWLEDGE_MAX_ATTEMPTS=2

# --- Step 4: approvals, checkpointing, QA ---
# Where runs paused for an approval are stored. `postgres` survives restarts and lets a staff console in another process resume
# them (run `make db-migrate` to create the tables). `memory` is lost when the process ends: only for quick demos.
SG_CHECKPOINTER=postgres
# How many times a reply that fails the QA checks may be revised before it is replaced by a safe fallback.
SG_QA_MAX_REVISIONS=1

# --- App ---
SG_DEFAULT_TENANT=qspiders_sample

# --- Tracing (self-hosted Langfuse; see README "Tracing with Langfuse") ---
# `make langfuse-init` generates the keys and writes them into your real .env for you.
# Tracing is OFF unless SG_TRACING_ENABLED=true AND both keys are set.
SG_TRACING_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://localhost:3100

# --- Step 5: web API + frontend ---
# Required by the API. Generate with `make auth-init` (writes SG_AUTH_SECRET into .env only if it is not set yet).
SG_AUTH_SECRET=
SG_TOKEN_TTL_MINUTES=480
SG_LOGIN_MAX_FAILURES=5
SG_LOGIN_LOCKOUT_SECONDS=300
SG_CHAT_MAX_MESSAGES_PER_MINUTE=20
# Comma-separated browser origins allowed to call the API directly. Leave empty when the frontend proxies /api (the default).
SG_CORS_ORIGINS=

# --- Step 6: evaluation ---
# Price per 1M tokens, only to turn measured token counts into "cost per ticket" in `make eval`. 0 = free/local model.
SG_EVAL_PRICE_PER_M_INPUT=0
SG_EVAL_PRICE_PER_M_OUTPUT=0

# --- Browser voice line (M2; see docs/M2.md). Run `make voice-setup` once, then:
# SG_VOICE_PROVIDER=real                       # real = faster-whisper + Piper + Silero VAD; fake = scripted stand-ins (tests)
# SG_VOICE_TTS_VOICE="/path/to/models/voices/en_US-lessac-medium.onnx"   # printed by make voice-setup
# SG_VOICE_STT_MODEL=base.en                   # tiny.en = faster, small.en = more accurate (CPU: base.en is a good start)
# SG_VOICE_STT_COMPUTE_TYPE=int8
# SG_VOICE_STT_THREADS=4
# SG_VOICE_SILENCE_MS=600                      # silence that ends one speech SEGMENT (a turn may merge several; see docs/M2_2.md)
# SG_VOICE_GRACE_COMPLETE_MS=250               # extra wait after a finished sentence before it is answered
# SG_VOICE_GRACE_SHORT_MS=700                  # ... after one or two words
# SG_VOICE_GRACE_INCOMPLETE_MS=1600            # ... after an unfinished sentence (raise THIS if sentences still split)
# SG_VOICE_MAX_TURN_S=30                       # merged audio of one turn is never longer
# SG_VOICE_MAX_PENDING_TURNS=3
# SG_VOICE_PACE_AUDIO=true                     # send speech at about real time so a barge-in cuts what you hear
# SG_VOICE_PACE_LEAD_MS=1500
# SG_VOICE_BARGE_IN_MS=250                     # speech this long interrupts the assistant
# SG_VOICE_MAX_SESSION_S=600
# SG_VOICE_MAX_TURNS=60
# SG_VOICE_ENABLED=true
# SG_VOICE_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000   # browser pages allowed to open the voice socket
