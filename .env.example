# Copy to .env and adjust. Never commit .env.

# --- Postgres (docker-compose) ---
POSTGRES_USER=supportgraph
POSTGRES_PASSWORD=supportgraph
POSTGRES_DB=supportgraph
POSTGRES_PORT=5432

# --- Model gateway ---
# provider: ollama | openai_compat | fake
#   fake          -> scripted model, no network; used by tests and for a no-LLM demo
#   ollama        -> local model (install Ollama, then: ollama pull qwen3:1.7b). Candidates are benchmarked on your machine: make bench-llm
#   openai_compat -> any OpenAI-compatible endpoint (free tiers like Groq/OpenRouter, or paid)
SG_LLM_PROVIDER=fake
SG_LLM_MODEL=qwen3:1.7b
# Opt-in candidate (better FAQ answers, ~1.5-2x slower, answered 1 of 7 held-out unanswerable questions): SG_LLM_MODEL=qwen3:4b-instruct-2507-q4_K_M with SG_LLM_MODEL_TRIAGE=qwen3:1.7b
# Sampling (defaults: temperature 0, provider defaults for the rest). Leave unset unless an experiment says otherwise (docs/MODEL_SELECTION.md):
# SG_LLM_TEMPERATURE=0.0
# SG_LLM_TOP_P=
# SG_LLM_TOP_K=
# SG_LLM_REPEAT_PENALTY=
# SG_LLM_SEED=
SG_LLM_BASE_URL=http://localhost:11434
SG_LLM_API_KEY=
# Optional per-role model, e.g. a smaller/faster model for triage. Empty = SG_LLM_MODEL.
# Roles: ACTION FAQ TRIAGE REWRITE PROPOSER CRITIC REVISER JUDGE
# SG_LLM_MODEL_TRIAGE=qwen3:1.7b
# Limits (milestone 0). One call must finish inside the timeout or the bot answers with a fixed "model unavailable" reply.
SG_LLM_TIMEOUT_SECONDS=60
SG_LLM_MAX_RETRIES=1
SG_LLM_MAX_OUTPUT_TOKENS=400
SG_LLM_NUM_CTX=4096
SG_LLM_KEEP_ALIVE=30m
SG_LLM_THINKING=false
# --- Real local AI (milestone 1b). To turn it on, edit YOUR .env (this file is only a template):
#   SG_LLM_PROVIDER=ollama   SG_EMBEDDING_PROVIDER=ollama   then: make ingest   make llm-smoke   make e2e-local
# Startup check of the Ollama server and the pulled models: off | warn (log, default) | strict (refuse to start).
# SG_LLM_PREFLIGHT=warn
# Load the models into memory in the background when the API starts, so the first student does not wait for a cold load.
# SG_LLM_WARMUP=true

# --- M3: latency (docs/M3.md). Every value below is the DEFAULT; uncomment only to change it. ---
# Pin Ollama's CPU threads for chat calls AND the warm-up preload (they must match, or Ollama reloads the model). Unset = Ollama decides.
# On a 4-core / 8-thread laptop, try 4 and compare with `make bench-voice` before keeping it.
# SG_LLM_NUM_THREAD=4
# SG_OBS_OLLAMA_METRICS=true            # record Ollama's load / prompt-eval / decode counters per call (numbers only)
# SG_OBS_COLD_LOAD_MS=800               # a turn whose model load took at least this long is marked "cold"
# SG_OBS_COLD_EMBED_MS=1500             # ... or whose embedding call took at least this long
# SG_WARMUP_PRIME_TRIAGE=true           # warm-up also runs one fixed triage call, one embedding and one database query
# Triage: "compact" = a shorter prompt (less CPU). OFF until `make eval-routing` shows no regression with the real model.
# SG_TRIAGE_PROMPT=full                 # full | compact
# SG_TRIAGE_MAX_OUTPUT_TOKENS=0         # cap on the triage JSON (0 = SG_LLM_MAX_OUTPUT_TOKENS). 160 is plenty for the schema.
# SG_TRIAGE_CACHE_SIZE=256              # identical message text => no triage model call (0 = off). Only successful model answers are cached.
# SG_TRIAGE_CACHE_TTL_SECONDS=3600
# Validated-answer cache for repeated FAQ questions (anonymous callers only by default). Re-checked on every hit; invalidated when documents change.
# SG_ANSWER_CACHE_SIZE=128              # 0 = off
# SG_ANSWER_CACHE_TTL_SECONDS=1800
# SG_ANSWER_CACHE_ANONYMOUS_ONLY=true
# Prompt size controls (OFF by default: they can drop the passage that holds the answer; the best passage is always kept). 0 = off.
# SG_RAG_CONTEXT_BAND=0                 # keep only passages scoring within this distance of the best one, e.g. 0.08
# SG_RAG_MAX_CONTEXT_CHARS=0            # cap on the total passage text sent to the model, e.g. 1800
# Optional extra model calls, OFF until measured on your machine (each adds seconds on CPU):
# SG_FAQ_CITATION_RETRIES=1   # an UNCITED answer is regenerated once with a reminder to cite (0 = never); same validation, abstains if it fails again
# SG_TRIAGE_OTHER_FLOOR=0.4   # category `other` at this confidence up to SG_TRIAGE_MIN_CONFIDENCE goes to the grounded FAQ instead of a clarifying question
# SG_QA_LLM_CRITIC=false      # LLM groundedness critic after the deterministic QA checks
# SG_REWRITER_MODE=glossary   # glossary (no model call) | llm (model rewrites the search query)
# Daily token cap for guarded calls; 0 = unlimited (right for local models). Only matters if you ever use a metered endpoint.
SG_LLM_DAILY_TOKEN_BUDGET=0
# Safety gate: any chat/embedding endpoint that is not on this machine or a private network is REFUSED unless this is true.
# Only turn it on deliberately, with synthetic data, after reading docs/decisions/0005-local-first-models.md.
SG_ALLOW_EXTERNAL_LLM=false

# --- Embeddings + RAG FAQ bot (build step 2) ---
# fake -> deterministic offline keyword-style embedder: for tests and the no-LLM demo, NOT for judging quality.
# Vectors must be 768-wide (the database column). nomic-embed-text is 768-wide:
#   ollama pull nomic-embed-text   and   SG_EMBEDDING_PROVIDER=ollama
# After changing the embedding model, run `make ingest` again (vectors from different models are never compared).
SG_EMBEDDING_PROVIDER=fake
SG_EMBEDDING_MODEL=nomic-embed-text
SG_EMBEDDING_BASE_URL=http://localhost:11434
SG_EMBEDDING_API_KEY=
# nomic-embed-text wants task prefixes. auto = the right ones for nomic-embed-text on a real provider (no-op for the fake embedder and for
# other models); none = never add them. Explicit QUERY/DOCUMENT prefixes below win. The prefix setting is part of the stored vector name, so
# changing it makes old vectors invisible (run `make ingest` again; nothing is deleted).
# SG_EMBEDDING_PREFIX_MODE=auto
SG_EMBEDDING_QUERY_PREFIX=
SG_EMBEDDING_DOCUMENT_PREFIX=
# Passages shown to the model per question, and the minimum cosine similarity for a passage to count as relevant.
# Below the minimum the bot abstains. Similarity scales differ by model: calibrate with `make eval-rag`.
SG_RAG_TOP_K=4
SG_RAG_MIN_SCORE=0.2
# Step 3: below this triage confidence the bot asks a clarifying question instead of guessing (0..1).
SG_TRIAGE_MIN_CONFIDENCE=0.6
# Step 3: how many searches the corrective knowledge agent may try per question (1..3; 1 = no retry).
SG_KNOWLEDGE_MAX_ATTEMPTS=2

# --- Step 4: approvals, checkpointing, QA ---
# Where runs paused for an approval are stored. `postgres` survives restarts and lets a staff console in another process resume
# them (run `make db-migrate` to create the tables). `memory` is lost when the process ends: only for quick demos.
SG_CHECKPOINTER=postgres
# How many times a reply that fails the QA checks may be revised before it is replaced by a safe fallback.
SG_QA_MAX_REVISIONS=1

# --- App ---
SG_DEFAULT_TENANT=qspiders_sample

# --- Tracing (self-hosted Langfuse; see README "Tracing with Langfuse") ---
# `make langfuse-init` generates the keys and writes them into your real .env for you.
# Tracing is OFF unless SG_TRACING_ENABLED=true AND both keys are set.
SG_TRACING_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://localhost:3100

# --- Step 5: web API + frontend ---
# Required by the API. Generate with `make auth-init` (writes SG_AUTH_SECRET into .env only if it is not set yet).
SG_AUTH_SECRET=
SG_TOKEN_TTL_MINUTES=480
SG_LOGIN_MAX_FAILURES=5
SG_LOGIN_LOCKOUT_SECONDS=300
SG_CHAT_MAX_MESSAGES_PER_MINUTE=20
# Comma-separated browser origins allowed to call the API directly. Leave empty when the frontend proxies /api (the default).
SG_CORS_ORIGINS=

# --- Step 6: evaluation ---
# Price per 1M tokens, only to turn measured token counts into "cost per ticket" in `make eval`. 0 = free/local model.
SG_EVAL_PRICE_PER_M_INPUT=0
SG_EVAL_PRICE_PER_M_OUTPUT=0

# --- Browser voice line (M2; see docs/M2.md). Run `make voice-setup` once, then:
# SG_VOICE_PROVIDER=real                       # real = faster-whisper + Piper + Silero VAD; fake = scripted stand-ins (tests)
# SG_VOICE_TTS_VOICE="/path/to/models/voices/en_US-lessac-medium.onnx"   # printed by make voice-setup
# SG_VOICE_STT_MODEL=base.en                   # tiny.en = faster, small.en = more accurate (CPU: base.en is a good start)
# SG_VOICE_STT_COMPUTE_TYPE=int8
# SG_VOICE_STT_THREADS=4
# SG_VOICE_SILENCE_MS=600                      # silence that ends one speech SEGMENT (a turn may merge several; see docs/M2_2.md)
# SG_VOICE_GRACE_COMPLETE_MS=250               # extra wait after a finished sentence before it is answered
# SG_VOICE_GRACE_SHORT_MS=700                  # ... after one or two words
# SG_VOICE_GRACE_INCOMPLETE_MS=1600            # ... after an unfinished sentence (raise THIS if sentences still split)
# SG_VOICE_MAX_TURN_S=30                       # merged audio of one turn is never longer
# SG_VOICE_MAX_PENDING_TURNS=3
# SG_VOICE_PACE_AUDIO=true                     # send speech at about real time so a barge-in cuts what you hear
# SG_VOICE_PACE_LEAD_MS=1500
# SG_VOICE_FILLER_AFTER_MS=1800               # say "One moment please" when the answer is not ready after this long (0 = never)
# SG_VOICE_STT_BEAM=1                         # 2-3: hears unusual words better, a little slower
# SG_VOICE_BARGE_IN_MS=250                     # speech this long interrupts the assistant
# SG_VOICE_MAX_SESSION_S=600
# SG_VOICE_MAX_TURNS=60
# SG_VOICE_ENABLED=true
# SG_VOICE_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000   # browser pages allowed to open the voice socket

# --- M4: staff live calls (all optional; these are the defaults) ---
# SG_CALLS_TAKEOVER_GRACE_S=15      # the staff owner's audio connection missing this long during a takeover -> the call ENDS (it never returns to the AI)
# SG_CALLS_MAX_LISTENERS=5          # staff audio connections per call
# SG_CALLS_LISTENER_QUEUE=200       # frames buffered per listener (a slow listener drops its own old audio)
# SG_CALLS_RECHECK_S=30             # staff sockets re-check token expiry / account state this often
# SG_CALLS_KEEP_ENDED_MINUTES=30    # ended calls stay in the Live Calls list this long
# SG_CALLS_HANDOVER_ANNOUNCEMENT=...  # M4.1: the spoken hand-over notice (default text is in app/config.py); played only after ownership is granted
# SG_CALLS_ANNOUNCEMENT_TIMEOUT_S=30  # a notice not finished by then is abandoned (shown to staff; they may speak)

# --- M5: Trial Verification Mode (all optional; these are the defaults) ---
# SG_TRIAL_RECORDING_PROVIDER=none    # none = calls are NEVER recorded (consent/retention still work) | local = WAV files on THIS machine's disk, never the database
# SG_TRIAL_RECORDINGS_DIR=data/recordings   # only used by the local provider; keep it out of git and backups you do not control
# SG_TRIAL_RECORDING_MAX_MB=200       # a recording this big is stopped (reason size_limit)
# SG_TRIAL_PURGE_INTERVAL_MIN=60      # retention job inside the API process; 0 = only on demand (`make purge-trial`)
# SG_TRIAL_METRICS_MAX_ROWS=5000      # calls summarised per metrics request

# --- M6: Knowledge store (all optional; these are the defaults) ---
# SG_KB_MAX_BYTES=200000                  # largest document body accepted (UTF-8 bytes)
# SG_KB_MAX_CHUNKS=300                    # a document needing more passages than this is refused before anything is embedded
# SG_KB_PROCESSING_STALE_S=300            # a version stuck in "processing" this long (a crash) may be processed again
# SG_KB_REQUIRE_SEPARATE_REVIEWER=false   # true: the administrator who proposed a feedback-based change cannot approve it (needs two administrators)

# --- M6 Part 2: AI-assisted knowledge change (all optional; these are the defaults) ---
# SG_KB_AI_DISCOVERY=v2                   # v2 = section/line evidence scan; v1 = the older document-level discovery
# SG_KB_AI_VERIFY=true                    # after publishing, search the live knowledge for references that still look outdated (advisory)
# SG_RAG_RETRIEVAL_MODE=hybrid            # chat retrieval: hybrid (vector + keyword) or vector (previous behaviour)
# SG_KB_AI_JUDGE=uncertain                # the model reads document SECTIONS and revises them: uncertain (value changes: only where rules are not sure; general changes: always) | all | off
# SG_KB_AI_JUDGE_THINKING=true            # qwen3 thinking for this job only (it runs in the background analysis, never in a chat turn)
# SG_KB_AI_JUDGE_TIMEOUT_S=300            # one model call; thinking on CPU is slow
# SG_KB_AI_JUDGE_MAX_CALLS=16             # model calls per analysis
# SG_KB_AI_MAX_SECTIONS=6                 # model calls per document (more sections are reported as not read)
# --- the THREE context limits (docs/PART2_FINAL.md, "Configuration reference"). The section sent is the largest logical unit that fits ALL of them. Defaults: CPU-only, 16 GB.
# SG_KB_AI_CONTEXT_TOKENS=1800            # INPUT capacity: document text per request (whole document -> heading sub-tree -> section -> blocks)
# SG_KB_AI_JUDGE_MAX_TOKENS=4096          # OUTPUT limit (Ollama num_predict): thinking + the whole revised section; a cut-off answer is rejected, never used
# SG_KB_AI_JUDGE_NUM_CTX=8192             # Ollama TOTAL window: prompt + thinking + answer; also sets RAM (KV cache). 12288 / 16384 are fine on 16 GB for experiments
# SG_KB_AI_THINKING_RESERVE_TOKENS=1500   # output tokens kept for reasoning when sizing a section
# SG_KB_AI_CONTEXT_MODE=adaptive          # adaptive | fixed (fixed = SG_KB_AI_JUDGE_WINDOW_CHARS characters, the earlier behaviour)
# SG_KB_AI_JUDGE_WINDOW_CHARS=1600
# --- validation of the model's revision
# SG_KB_AI_SEMANTIC_CHECK=uncertain       # a second, short model call (PASS/FAIL/UNSURE): uncertain (only when a safeguard flagged something) | all | off
# SG_KB_AI_MAX_CHANGED_FRACTION=0.6       # more of a section changed than this -> the whole revision goes to a person
# SG_KB_AI_MAX_REMOVED_FRACTION=0.5       # more of a section deleted than this -> rejected as an accidental deletion
# SG_KB_AI_SEMANTIC_ADMIT=0.45             # semantic similarity that ALONE sends a document to the model (recall first; people decide)
# SG_KB_AI_SEMANTIC_ADMIT_UNKEYED=0.7      # the same, for a document lacking the subject's distinguishing title word (a sibling subject)
# SG_KB_AI_RECHECK_UNCHANGED=true         # a removal/correction answered 'unchanged' although search found lines: one second look
# SG_KB_AI_EDIT_RETRIES=1                 # one more attempt, with the reasons, when a revision is rejected or the second check fails
# SG_KB_AI_TRACE_CONTENT=false            # debugging: keep prompt / answer / section text in the request's processing log (never written to the log file)
# Final M6 (docs/M6_FINAL.md)
# SG_KB_DIRECT_ARCHIVE=false              # a PUBLISHED document is deleted only through a deletion request an administrator approves; true = the old one-click archive
# SG_KB_PURGE_ENABLED=true               # M6 refinement 2.4: administrators may PERMANENTLY delete an archived / never-published document (confirmed, audited)
# SG_KB_PURGE_MIN_ARCHIVED_DAYS=0         # retention: days a document must stay archived before permanent deletion is allowed (0 = no waiting period)
# SG_KB_LEGACY_FOLDERS=false              # the folder API is retired (410); true re-enables it (folder rows were never deleted, so this is reversible)
# SG_LLM_MODEL_IMPACT=qwen3:1.7b          # or qwen3:4b for harder passages (slower)

# M8: telephone line (docs/M8.md). OFF by default. A public number through Edesy is a PAID service: enable it only after you decide to.
# SG_TELEPHONY_PROVIDER=none              # edesy = accept Edesy media streams at /api/telephony/edesy/stream/<token>
# SG_TELEPHONY_STREAM_TOKEN=              # >= 32 random characters (the URL is the only protection Edesy offers): python -c "import secrets; print(secrets.token_urlsafe(32))"
# SG_TELEPHONY_SAMPLE_RATE=16000          # 8000 or 16000, the same as `make edesy-attach RATE=...`
# SG_TELEPHONY_TENANT=qspiders_sample     # tenant for calls to numbers not listed below
# SG_TELEPHONY_NUMBER_TENANTS=            # dialled number => tenant, e.g. 917969002802=qspiders_sample
# SG_TELEPHONY_ALLOWED_IPS=               # optional allowlist of source addresses for the stream
# SG_TELEPHONY_MAX_CONCURRENT=4
# SG_PHONE_PIN_LENGTH=6                   # the phone-support PIN a caller types (* PIN #) to prove the account their number claims
# SG_PHONE_PIN_MAX_ATTEMPTS=5             # wrong PINs in a row before phone verification is locked
# SG_PHONE_PIN_LOCK_MINUTES=15
# SG_PHONE_PIN_ATTEMPTS_PER_CALL=3
# EDESY_API_KEY is NOT read from .env: export it in your shell only when you run `make edesy-*`.
