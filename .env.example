# Copy to .env and adjust. Never commit .env.

# --- Postgres (docker-compose) ---
POSTGRES_USER=supportgraph
POSTGRES_PASSWORD=supportgraph
POSTGRES_DB=supportgraph
POSTGRES_PORT=5432

# --- Model gateway ---
# provider: ollama | openai_compat | fake
#   fake          -> scripted model, no network; used by tests and for a no-LLM demo
#   ollama        -> local model (install Ollama, then: ollama pull qwen2.5:7b)
#   openai_compat -> any OpenAI-compatible endpoint (free tiers like Groq/OpenRouter, or paid)
SG_LLM_PROVIDER=fake
SG_LLM_MODEL=qwen2.5:7b
SG_LLM_BASE_URL=http://localhost:11434
SG_LLM_API_KEY=

# --- App ---
SG_DEFAULT_TENANT=acme_store

# --- Tracing (self-hosted Langfuse; see README "Tracing with Langfuse") ---
# `make langfuse-init` generates the keys and writes them into your real .env for you.
# Tracing is OFF unless SG_TRACING_ENABLED=true AND both keys are set.
SG_TRACING_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://localhost:3100
